<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Calculator Pro - By Oscar Kelvin</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',sans-serif}
body{background:#0f172a;display:flex;justify-content:center;align-items:center;min-height:100vh;padding:20px}
.calc{background:#1e293b;width:100%;max-width:360px;border-radius:24px;padding:20px;box-shadow:0 20px 60px rgba(0,0,0,.4)}
.header{display:flex;justify-content:space-between;align-items:center;color:#94a3b8;margin-bottom:15px;font-size:14px}
.display{background:#0f172a;border-radius:16px;padding:20px;text-align:right;margin-bottom:20px;min-height:100px}
#prev{color:#64748b;font-size:18px;min-height:24px}
#curr{color:white;font-size:42px;font-weight:700;margin-top:5px;word-wrap:break-word}
.buttons{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
button{height:65px;border:none;border-radius:14px;font-size:22px;font-weight:600;cursor:pointer;transition:.15s}
button:active{transform:scale(.92)}
.num{background:#334155;color:white}
.op{background:#f59e0b;color:white}
.func{background:#475569;color:#cbd5e1}
.equal{background:#10b981;color:white;grid-column:span 2}
.zero{grid-column:span 2}
.brand{text-align:center;color:#475569;margin-top:20px;font-size:12px;letter-spacing:1px}
</style>
</head>
<body>
<div class="calc">
  <div class="header"><span>Calculator Pro</span><span>● ● ●</span></div>
  <div class="display"><div id="prev"></div><div id="curr">0</div></div>
  <div class="buttons">
    <button class="func" onclick="clearAll()">AC</button>
    <button class="func" onclick="del()">DEL</button>
    <button class="func" onclick="append('%')">%</button>
    <button class="op" onclick="append('/')">÷</button>
    <button class="num" onclick="append('7')">7</button>
    <button class="num" onclick="append('8')">8</button>
    <button class="num" onclick="append('9')">9</button>
    <button class="op" onclick="append('*')">×</button>
    <button class="num" onclick="append('4')">4</button>
    <button class="num" onclick="append('5')">5</button>
    <button class="num" onclick="append('6')">6</button>
    <button class="op" onclick="append('-')">−</button>
    <button class="num" onclick="append('1')">1</button>
    <button class="num" onclick="append('2')">2</button>
    <button class="num" onclick="append('3')">3</button>
    <button class="op" onclick="append('+')">+</button>
    <button class="num zero" onclick="append('0')">0</button>
    <button class="num" onclick="append('.')">.</button>
    <button class="equal" onclick="calc()">=</button>
  </div>
  <div class="brand">BUILT BY OSCAR KELVIN • ₦25K</div>
</div>
<script>
let curr=document.getElementById('curr'), prev=document.getElementById('prev'), exp='';
function append(v){if(curr.innerText=='0'&&v!='.')exp='';exp+=v;curr.innerText=exp;prev.innerText=exp}
function clearAll(){exp='';curr.innerText='0';prev.innerText=''}
function del(){exp=exp.slice(0,-1);curr.innerText=exp||'0';prev.innerText=exp}
function calc(){try{let res=eval(exp);prev.innerText=exp+' =';curr.innerText=res;exp=res.toString()}catch{curr.innerText='Error';exp=''}} 
</script>
</body>
</html>
